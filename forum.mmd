
erDiagram
    USERS ||--o{ POSTS : creates
    USERS ||--o{ FOLLOWS : following
    USERS ||--o{ FOLLOWS : followed

    USERS {
        int id PK
        varchar username
        varchar role
        timestamp created_at
    }

    POSTS {
        int id PK
        varchar title
        text body
        int user_id FK
        varchar status
        timestamp created_at
    }

    FOLLOWS {
        int following_user_id FK
        int followed_user_id FK
        timestamp created_at
    }
